# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]

# C extensions
*.so

# Distribution, packaging, virtual env
bin/
build/
develop-eggs/
dist/
eggs/
lib/
lib64/
parts/
sdist/
var/
*.egg-info/
.installed.cfg
*.egg
/
# virt env
.venv

# Installer logs and all logs
pip-log.txt
pip-delete-this-directory.txt
*.log

# Unit test / coverage reports
.tox/
.coverage
.cache
nosetests.xml
coverage.xml

# Translations
*.mo
*.pot

# Sphinx documentation
docs/_build/


# safety nets since the real config live in %LOCALAPPDATA%\mamemai (or ~/.config/mamemai on Linux)
# example.toml files are tracked on purpose — no secrets, just a template to copy from
server/config/*
!server/config/mamemai.example.toml
client/config/*
!client/config/mamemai.example.toml

.env
.env.local

# Raw session logs — full conversation transcripts, kept forever per CLAUDE.md, must
# never be committed. Written outside the repo tree, under the platform data dir
# (log_dir in mamemai.toml, e.g. ~/.local/share/mamemai/sessions/ on Linux,
# %LOCALAPPDATA%\mamemai\sessions on Windows) — this *.jsonl catch-all is a safety net
# in case one ever lands inside the repo tree.
*.jsonl

# my exclusion
xprivate/

# Claude Code local files — machine-specific (host names, local paths). Never commit.
.claude/settings.local.json
.claude/machine-aliases.local.json
eval/drafts/

# Frozen evaluation corpora are source data, unlike session logs (*.jsonl above)
!eval/corpora/**/*.jsonl
